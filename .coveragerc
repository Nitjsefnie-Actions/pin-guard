# Read by coverage when the test-ratchet `run` step in tests.yml measures
# the suite. `parallel` keeps the suite's several python3 processes from
# overwriting one another's data files. `include` scopes the REPORT to the
# repository's own surface -- the screen, the action's driver and the CI
# scripts; the suite's own files are measured too and do not appear in it.

[run]
parallel = True

[report]
include =
    */check_pin_tests.py
    */run.py
    */scripts/ci/*.py
