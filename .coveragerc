# Coverage configuration the test-ratchet `run` action keeps (tests.yml).
# The suite's screen and driver code runs in python3 subprocesses of the
# pytest process; the action's coverage patches start the measurer inside
# each of them, and `parallel` keeps those processes from overwriting one
# another's data files before they are combined.
#
# `include` is the measured file set the coverage floor in
# .github/ci-thresholds.json was recorded on: the screen, the action's
# driver and the CI scripts. The suite's own files are measured too and
# simply do not appear in the report.

[run]
parallel = True

[report]
include =
    */check_pin_tests.py
    */run.py
    */scripts/ci/*.py
